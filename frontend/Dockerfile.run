# 运行专用 Dockerfile（不包含 Node.js 构建步骤）
# 用于本地编译场景：在本地 npm run build 后，上传 dist/ 到服务器构建运行镜像
#
# 前置步骤：
#   1. 本地构建：cd frontend && npm run build
#   2. 上传文件：scp -r frontend/dist server:~/ElainaBlog/frontend/
#              scp frontend/nginx.conf server:~/ElainaBlog/frontend/

FROM nginx:stable-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
