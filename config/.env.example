# Docker Compose 环境变量（项目根目录）
# 复制为项目根目录的 .env 后修改：cp config/.env.example .env
#
# docker-compose.yml 从项目根目录的 .env 读取变量进行插值

# MySQL root 密码（必须与 config/backend/config.prod.yaml 中 db.password 一致）
MYSQL_ROOT_PASSWORD=your_mysql_password

# MySQL 数据库名（与 config.prod.yaml 中 db.db_name 一致）
MYSQL_DATABASE=ElainaBlog

# docker远程镜像地址（以阿里云为例）
DOCKER_REGISTRY=registry.<地域>.aliyuncs.com
DOCKER_NAMESPACE=<命名空间>
