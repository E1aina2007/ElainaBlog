# 运行模式：dev 开发 / prod 生产（仅读取环境变量，不读 yaml；Docker 部署时改为 prod）
MODE=dev
# 配置文件路径（本地可指定；Docker 由 compose 注入，无需设置）
# CONFIG_PATH=configs/config.prod.yaml

# ===== Docker Compose 环境变量（backend/.env，Docker 通过 --env-file backend/.env 传入）=====

# MySQL root 密码（必填；会注入 backend 容器作为 MYSQL_ROOT_PASSWORD，覆盖 db.password）
# 避免使用 @ : / ? 等特殊字符（会拼接进 migrate 容器的连接串）
MYSQL_ROOT_PASSWORD=your_mysql_password

# MySQL 数据库名（会注入 backend 容器作为 MYSQL_DATABASE，覆盖 db.db_name）
MYSQL_DATABASE=ElainaBlog

# 远程镜像仓库（以阿里云为例）
DOCKER_REGISTRY=registry.<地域>.aliyuncs.com
DOCKER_NAMESPACE=<命名空间>
# 镜像标签：默认 latest；回滚时改为 CI 推送的 commit SHA
# IMAGE_TAG=latest

# ===== 后端配置覆盖（可选）=====
# 优先级高于 yaml；统一使用 backend/.env（本地开发直接生效，Docker 部署通过 --env-file 传入 compose）

# 数据库（Docker 部署时注释掉下面三行本地值，让 compose 默认 mysql/3306/root 生效）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
# 密码与库名复用上方 MYSQL_ROOT_PASSWORD / MYSQL_DATABASE，无需重复设置

# Redis（Docker 部署时注释掉，让 compose 默认 redis:6379 生效）
REDIS_ADDRESS=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 密钥
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret

# SMTP
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_FROM=your_email@qq.com
SMTP_PASSWORD=your_authorization_code
SMTP_SSL=true

# 服务
SERVER_PORT=9178

# 上传目录
UPLOAD_PATH=uploads
UPLOAD_AVATAR_PATH=uploads/avatars

# 管理员（启动时自动创建/重置）
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=your_admin_password
